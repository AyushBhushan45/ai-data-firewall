# ==============================================================================
# AI Data Firewall — Environment Configuration Example (.env.example)
#
# IMPORTANT:
# This file contains non-sensitive example placeholders.
# Under no circumstances should real production API keys or tokens be committed.
# ==============================================================================

# Target upstream AI service URL (Use https://example.invalid for testing or http://127.0.0.1:11434 for local Ollama)
AIFIREWALL_UPSTREAM=https://example.invalid

# Provider adapter family: openai, anthropic, gemini, or ollama
AIFIREWALL_PROVIDER=openai

# Local proxy network binding (default: 127.0.0.1)
AIFIREWALL_HOST=127.0.0.1

# Local proxy port (default: 8080)
AIFIREWALL_PORT=8080

# Security policy preset: redact-secrets, block-secrets, warn-secrets, or allow-all
AIFIREWALL_POLICY_PRESET=redact-secrets

# Optional path to custom configuration file (.toml or .json)
# AIFIREWALL_CONFIG=examples/firewall.toml

# Upstream total timeout in seconds (default: 60.0)
AIFIREWALL_TOTAL_TIMEOUT=60.0

# Request body size limit in bytes (default: 5242880 = 5MB)
AIFIREWALL_MAX_REQUEST_BYTES=5242880

# Response body size limit in bytes (default: 10485760 = 10MB)
AIFIREWALL_MAX_RESPONSE_BYTES=10485760
