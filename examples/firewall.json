{
  "_comment": "AI Data Firewall Example Configuration (JSON)",
  "proxy": {
    "host": "127.0.0.1",
    "port": 8080,
    "upstream_url": "http://127.0.0.1:11434",
    "provider": "ollama",
    "connect_timeout": 5.0,
    "read_timeout": 30.0,
    "write_timeout": 10.0,
    "total_timeout": 60.0,
    "max_request_body_bytes": 5242880,
    "max_response_body_bytes": 10485760
  },
  "policy": {
    "default_action": "allow",
    "preset": "redact-secrets",
    "rules": [
      {
        "rule_id": "block-critical-secrets",
        "action": "block",
        "category": "secret",
        "minimum_severity": "critical",
        "minimum_confidence": 0.8,
        "description": "Block any request or response with high-confidence critical secrets"
      },
      {
        "rule_id": "redact-high-secrets",
        "action": "redact",
        "category": "secret",
        "minimum_severity": "high",
        "minimum_confidence": 0.7,
        "description": "Mask high-severity secrets before forwarding or returning"
      }
    ]
  }
}
